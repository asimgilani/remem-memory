{
  "mcpServers": {
    "remem": {
      "command": "python3",
      "cwd": ".",
      "args": [
        "-I",
        "-c",
        "import os,runpy,sys;root=sys.argv[1];root=os.getcwd() if root.startswith('$') else root;scripts=os.path.join(root,'scripts');launcher=os.path.join(scripts,'remem_mcp_launcher.py');sys.path.insert(0,scripts);sys.argv=[launcher,*sys.argv[2:]];runpy.run_path(launcher,run_name='__main__')",
        "${CLAUDE_PLUGIN_ROOT}"
      ]
    }
  }
}
