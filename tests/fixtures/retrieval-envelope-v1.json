{
  "version": "retrieval-envelope-v1",
  "change_note": "Ordinary recall inspects each record fully, then redacts credential and sensitive mapping entries and secret-bearing keys, replaces secret-bearing strings with a fixed marker, and only then truncates structured leaves to the UTF-8 serialization budget. Off-record raw or serialized hits drop the whole record. No automatic-capture path or generated-ID entropy exemptions apply. Continuation never echoes queries, filters, keys, snippets, or fingerprints.",
  "scope": {
    "applies_to": [
      "ordinary structured recall envelopes"
    ],
    "does_not_apply_to": [
      "explicit raw-document access",
      "manual ingest, create, or update",
      "backend provider prompts",
      "deployed hook, CLI, MCP, or OpenClaw adapters"
    ],
    "guarantee": "Best-effort nested redaction and structured truncation for ordinary recall. This unit alone does not protect deployed retrieval."
  },
  "origins": [
    "python_hook",
    "python_cli",
    "python_mcp",
    "openclaw_tool",
    "openclaw_cli"
  ],
  "kinds": [
    "document",
    "chunk",
    "fact",
    "entity",
    "synthesis"
  ],
  "redaction_marker": "[redacted]",
  "default_budget": 50000,
  "errors": {
    "invalid_origin": "invalid retrieval origin",
    "invalid_budget": "invalid retrieval budget",
    "budget_too_small": "retrieval budget below minimum envelope",
    "invalid_records": "invalid retrieval records",
    "invalid_sensitive_fields": "invalid sensitive fields",
    "unsupported_value": "unsupported retrieval value",
    "exceeds_bounds": "retrieval input exceeds bounds"
  },
  "count_semantics": {
    "redaction.fields": "Mapping entries removed because of credential-like names, additive sensitive names, or secret-bearing keys. Nested content inside a removed entry is not counted separately.",
    "redaction.values": "String leaves replaced by the fixed redaction marker. The whole string is replaced; secrets are not cut into a prefix.",
    "redaction.records": "Whole records omitted because an off-record indication appeared in the raw or serialized policy view.",
    "truncation.omitted_items": "Records, object members, or array members dropped to satisfy the byte budget. Off-record redaction is counted under redaction.records instead.",
    "truncation.omitted_characters": "Unicode code points removed from kept string leaves. Omitted items do not add their lengths here."
  },
  "python_only": [
    "shared-references-checked-in-each-field-context",
    "cyclic-values-rejected-without-content"
  ],
